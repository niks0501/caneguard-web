# Production template for the shared server .env (shared/api/.env).
# Copy it once, fill every <placeholder> on the server, and never commit the result.
# api/.env.example is the LOCAL template: its localhost, reverb and debug values
# break sign-in or boot if they reach production. Mail delivery and accepted
# model versions are set by their own runbooks and are not listed here.

APP_NAME=CaneGuard
APP_ENV=production
# Generate once with `php artisan key:generate --show`; never regenerate afterwards
# (it signs out everyone and breaks encrypted values).
APP_KEY=<generated-once>
APP_DEBUG=false
APP_URL=https://caneguard.online
# The APP_URL host is always trusted; list extra hostnames only if needed.
APP_TRUSTED_HOSTS=caneguard.online

# Must be https: invitation and password-reset links refuse an http origin.
FRONTEND_URL=https://caneguard.online
CORS_ALLOWED_ORIGINS=https://caneguard.online
SANCTUM_STATEFUL_DOMAINS=caneguard.online
CANEGUARD_REPORT_EMBED_ORIGINS=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# The code default is sqlite; production is MySQL.
DB_CONNECTION=mysql
DB_HOST=<mysql-host>
DB_PORT=3306
DB_DATABASE=<database>
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_TIMEZONE=+00:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave unset for a host-only cookie. A value that does not match the host
# (for example localhost) makes /login fail with 419.
# SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Realtime is off. With no broadcaster the case events are not dispatched, so
# nothing piles up in the jobs table. log and reverb both queue a job per event.
# reverb without REVERB_* keys and a running server fails at boot.
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# District used for field-inspector access and Admin Settings.
# A matching row must exist in the districts table.
CANEGUARD_PILOT_DISTRICT_CODE=<district-code>

CANEGUARD_PASSWORD_MIN_LENGTH=15
CANEGUARD_PASSWORD_MAX_LENGTH=128
CANEGUARD_SECURITY_AUDIT_RETENTION_DAYS=2555

# Weekly report send needs a supervised queue worker and SMTP first.
CANEGUARD_WEEKLY_SEND_ENABLED=false

# Aerial analysis stays off until the model and Python are staged (see
# docs/production-deployment.md). Use true or false; the preflight and the
# app read it as a boolean.
CANEGUARD_AERIAL_ANALYSIS_ENABLED=false

# Never set in production: demo account passwords (CANEGUARD_FIELD_PASSWORD,
# CANEGUARD_REVIEWER_PASSWORD, CANEGUARD_ADMIN_PASSWORD), CANEGUARD_DASHBOARD_SEED_*,
# and the retired CANEGUARD_SELF_REGISTRATION_ENABLED, CANEGUARD_PILOT_ROSTER_CERTIFIED
# and CANEGUARD_ACCOUNTS_ENABLED.
