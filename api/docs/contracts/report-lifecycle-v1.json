{
  "$id": "https://github.com/niks0501/caneguard-web/blob/main/docs/contracts/report-lifecycle-v1.json",
  "artifact_format": "caneguard-lifecycle-contract",
  "contract": "report-lifecycle-v1",
  "version": 1,
  "status": "stable",
  "owner": "niks0501/caneguard-web/api",
  "dimensions": {
    "case_state": {
      "values": ["open", "closed"],
      "authority": "reviewer_or_admin",
      "description": "Whether office handling is still active."
    },
    "verification_outcome": {
      "values": ["not_determined", "verified", "unable_to_verify"],
      "authority": "reviewer_or_admin",
      "description": "The current authority verification outcome."
    },
    "field_validation_state": {
      "values": ["unassigned", "assigned", "in_progress", "completed"],
      "authority": "assignment_workflow",
      "description": "Progress of field-validation assignment work."
    },
    "referral_state": {
      "values": ["not_referred", "referred", "expert_response_received"],
      "authority": "reviewer_or_admin",
      "description": "Progress of an expert referral handoff."
    }
  },
  "legacy_projection": {
    "submitted_unverified": {
      "case_state": "open",
      "verification_outcome": "not_determined",
      "field_validation_state": "unassigned",
      "referral_state": "not_referred"
    },
    "for_field_validation": {
      "case_state": "open",
      "verification_outcome": "not_determined",
      "field_validation_state": "unassigned",
      "referral_state": "not_referred"
    },
    "verified_by_staff": {
      "case_state": "closed",
      "verification_outcome": "verified",
      "field_validation_state": "unassigned",
      "referral_state": "not_referred"
    },
    "unable_to_verify": {
      "case_state": "closed",
      "verification_outcome": "unable_to_verify",
      "field_validation_state": "unassigned",
      "referral_state": "not_referred"
    },
    "resolved": {
      "case_state": "closed",
      "verification_outcome": "not_determined",
      "field_validation_state": "unassigned",
      "referral_state": "not_referred"
    },
    "unknown": {
      "case_state": "closed",
      "verification_outcome": "not_determined",
      "field_validation_state": "unassigned",
      "referral_state": "not_referred"
    }
  },
  "rules": {
    "verification_does_not_close_case": true,
    "field_validation_completion_does_not_verify_or_close": true,
    "referral_is_not_verification_outcome": true,
    "field_reporter_can_complete_assignment": true,
    "field_reporter_can_close_case": false,
    "completed_validation_cannot_be_reassigned_or_removed": true,
    "final_disposition_roles": ["reviewer", "admin"],
    "ai_evidence_role": "decision_support_only"
  },
  "payload_contracts": [
    "mobile-report-upload-v2",
    "mobile-field-validation-assignment-v1",
    "mobile-field-validation-completion-v1",
    "mobile-notifications-v1"
  ],
  "versioning": {
    "same_major_compatible_widening": [
      "adding optional metadata without changing lifecycle meanings",
      "adding enum values while preserving existing state meanings"
    ],
    "new_major_required": [
      "removing or renaming a dimension or state",
      "changing state ownership, transition meaning, or legacy projection",
      "making field-validation completion imply verification or closure",
      "treating AI evidence as authority verification"
    ]
  }
}
