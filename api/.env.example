APP_NAME=CaneGuard
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
# Comma-separated hostnames accepted by the API; keep this aligned with APP_URL in deployments.
APP_TRUSTED_HOSTS=localhost

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=caneguard
DB_USERNAME=caneguard_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_TIMEZONE=+00:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Reverb (run `php artisan reverb:start` from the api directory)
REVERB_APP_ID=caneguard-local
REVERB_APP_KEY=caneguard-local-key
REVERB_APP_SECRET=caneguard-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS="${FRONTEND_URL}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Authentication recovery links must point to the deployed Web origin.
CANEGUARD_VERIFICATION_URL="${FRONTEND_URL}/verify-email"
CANEGUARD_PASSWORD_RESET_URL="${FRONTEND_URL}/reset-password"
CANEGUARD_PASSWORD_MIN_LENGTH=15
CANEGUARD_PASSWORD_MAX_LENGTH=128
CANEGUARD_SECURITY_AUDIT_RETENTION_DAYS=2555

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CANEGUARD_FIELD_PASSWORD=
CANEGUARD_REVIEWER_PASSWORD=
CANEGUARD_ADMIN_PASSWORD=
CANEGUARD_EXPERT_PASSWORD=
