APP_NAME=CaneGuard
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
# Comma-separated hostnames accepted by the API; keep this aligned with APP_URL in deployments.
APP_TRUSTED_HOSTS=localhost

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# FRONTEND_URL is automatically allowed to frame report HTML; optional additional exact HTTP(S) origins:
CANEGUARD_REPORT_EMBED_ORIGINS=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=caneguard
DB_USERNAME=caneguard_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_TIMEZONE=+00:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Reverb (run `php artisan reverb:start` from the api directory)
REVERB_APP_ID=caneguard-local
REVERB_APP_KEY=caneguard-local-key
REVERB_APP_SECRET=caneguard-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS="${FRONTEND_URL}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production: MAIL_MAILER=smtp with a real provider and MAIL_REQUIRE_TLS=true. In production the log and array
# mailers and smtp without TLS count as "not sent", so invites report failure. `php artisan auth:set-password-link`
# is the fallback for an account that has not completed onboarding; its target is CANEGUARD_OPERATOR_LINK_EMAIL.
# The command boots fresh from this file when APP_CONFIG_CACHE names an absent path in the deploy-owned shared directory, it refuses to run with a config cache loaded, so no cache is rebuilt (see docs/production-deployment.md). MAIL_URL is not read; use the MAIL_* variables only.
# CANEGUARD_OPERATOR_LINK_EMAIL=
# CANEGUARD_OPERATOR_LINK_NO_PASSWORD_CONFIRMED= (set to the same account email after confirming it has no password)
MAIL_MAILER=log
MAIL_REQUIRE_TLS=false
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
# Plaintext loopback relay (Mailpit or MailHog) only; production keeps MAIL_REQUIRE_TLS=true.
MAIL_REQUIRE_TLS=false
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Authentication recovery links must point to the deployed Web origin.
CANEGUARD_VERIFICATION_URL="${FRONTEND_URL}/verify-email"
CANEGUARD_PASSWORD_RESET_URL="${FRONTEND_URL}/reset-password"
CANEGUARD_PASSWORD_MIN_LENGTH=15
CANEGUARD_PASSWORD_MAX_LENGTH=128
CANEGUARD_ACCEPTED_MODEL_VERSIONS=v2.0-mobilenetv2,v1.0-mobilenetv2
# Public registration is disabled unconditionally; this retired switch is not read.
CANEGUARD_SELF_REGISTRATION_ENABLED=false
# Retired: office roster certification is an operator-owned, evidence-backed decision.
CANEGUARD_PILOT_ROSTER_CERTIFIED=false
# District used for seeded office memberships; replace with the provisioned pilot district code.
CANEGUARD_PILOT_DISTRICT_CODE=nasugbu-issuing
# Production deploys run caneguard:bootstrap, which requires this name and creates the district when missing.
CANEGUARD_PILOT_DISTRICT_NAME=
# Optional: first administrator, created when no active admin exists. They receive a set-password email; no password lives in env.
CANEGUARD_BOOTSTRAP_ADMIN_EMAIL=
# Weekly report delivery. Keep the gate false until the queue worker and SMTP below are live.
CANEGUARD_WEEKLY_SEND_ENABLED=false

# Experimental aerial canopy check. This is only the install gate: keep false
# until the operator has staged the ONNX model and Python environment, and note
# that an Admin must also turn the check on in Admin Settings (feature_switches,
# off by default) before any route stops answering 404.
CANEGUARD_AERIAL_ANALYSIS_ENABLED=false
CANEGUARD_AERIAL_PYTHON=python3
CANEGUARD_AERIAL_MODEL_PATH=

# Dedicated weekly-report mailer (TLS required, never falls back to log/array).
# smtp = STARTTLS (port 587); smtps = implicit TLS (port 465). Set the credentials only in the server .env.
CANEGUARD_WEEKLY_SMTP_SCHEME=smtp
CANEGUARD_WEEKLY_SMTP_HOST=smtp.example.invalid
CANEGUARD_WEEKLY_SMTP_PORT=587
CANEGUARD_WEEKLY_SMTP_USERNAME=
CANEGUARD_WEEKLY_SMTP_PASSWORD=
CANEGUARD_SECURITY_AUDIT_RETENTION_DAYS=2555

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CANEGUARD_FIELD_PASSWORD=
CANEGUARD_REVIEWER_PASSWORD=
CANEGUARD_ADMIN_PASSWORD=

# Local dashboard seed volume: current month plus recent months, with all
# modeled Bago barangays and Model V1 conditions represented in each month.
CANEGUARD_DASHBOARD_SEED_MONTHS_BACK=8
CANEGUARD_DASHBOARD_SEED_REPORTS_PER_BARANGAY_CONDITION=2
CANEGUARD_DASHBOARD_SEED_VALIDATION_SPREAD=5
CANEGUARD_DASHBOARD_SEED_CLOSURE_SPREAD=4
