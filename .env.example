# Keep localhost aligned with the Web origin at http://localhost:5173 for Sanctum cookies/CSRF.
VITE_API_BASE_URL=http://localhost:8000
VITE_DATA_SOURCE=api
VITE_REPORT_REFRESH_MS=600000
VITE_MAPTILER_KEY=
# Public registration is disabled unconditionally; the Web /register route redirects
# to sign-in and ignores this retired switch.
VITE_CANEGUARD_SELF_REGISTRATION_ENABLED=false

# Laravel Reverb / Echo
VITE_REALTIME_ENABLED=true
# Leave empty to disable Echo; set the API's matching REVERB_APP_KEY to enable it.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
