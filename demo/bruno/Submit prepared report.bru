meta {
  name: Submit prepared report
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v2/mobile/reports
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{fieldToken}}
}

headers {
  Accept: application/json
}

body:multipart-form {
  client_uuid: {{$guid}}
  image: @file({{imagePath}})
  image_source_type: camera
  source_width: 1254
  source_height: 1254
  predicted_label: smut
  confidence: 0.82
  class_scores[healthy]: 0.08
  class_scores[mosaic]: 0.10
  class_scores[rust]: 0.01
  class_scores[smut]: 0.97
  symptom_keys[]: smut
  checklist_consistency: consistent
  reported_severity: moderate
  barangay: Mabini
  model_version: v1.0-mobilenetv2
  preprocess_ms: 12.5
  inference_ms: 95.75
  total_ms: 122.25
  captured_at: 2026-07-27T09:00:00.456+08:00
}

tests {
  test("creates a report", function() {
    expect([200, 201]).to.include(res.status);
  });
}
