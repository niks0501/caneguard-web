{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Prepare Web/API Worktree",
      "command": "bash \"$T3CODE_PROJECT_ROOT/.t3/setup-worktree.sh\"",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Verify Web/API (Fast)",
      "command": "bash \"$T3CODE_PROJECT_ROOT/.t3/verify-worktree.sh\"",
      "runOnWorktreeCreate": false,
      "async": false
    },
    {
      "name": "Create CaneGuard Test Accounts",
      "command": "bash \"$T3CODE_PROJECT_ROOT/.t3/seed-test-accounts.sh\"",
      "runOnWorktreeCreate": false,
      "async": false
    }
  ]
}
