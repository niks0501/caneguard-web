{
  "contract": "mobile-duplicate-assistance-v2",
  "version": 2,
  "owner": "caneguard-web",
  "consumer": "caneguard-mobile",
  "wire": {
    "method": "GET",
    "path": "/api/v2/mobile/reports/possible-matches",
    "authentication": {
      "scheme": "sanctum_bearer",
      "ability": "report:submit",
      "role": "field_reporter"
    },
    "query": {
      "predicted_label": {
        "required": true,
        "type": "enum",
        "values": [
          "healthy",
          "mosaic",
          "rust",
          "smut"
        ]
      },
      "final_latitude": {
        "required": false,
        "nullable": true,
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "final_longitude": {
        "required": false,
        "nullable": true,
        "type": "number",
        "minimum": -180,
        "maximum": 180
      }
    },
    "response": {
      "message": "string",
      "data": {
        "type": "array",
        "items": {
          "case": {
            "uuid": "string",
            "reference_code": "string",
            "submitted_at": "ISO-8601 datetime"
          },
          "match": {
            "condition": "healthy|mosaic|rust|smut",
            "distance_meters": "non-negative number",
            "basis": [
              "same_condition",
              "nearby_location",
              "recent_submission"
            ]
          },
          "message": "Possible recent match. Compare this case before deciding."
        }
      },
      "meta": {
        "possible_match": "boolean",
        "can_submit": true,
        "assessment": "condition_and_location|location_unavailable",
        "recent_window_hours": 72,
        "location_radius_meters": 100
      }
    }
  },
  "matching": {
    "same_condition": "predicted_label equality",
    "nearby_location": "server-calculated distance <= 100 meters",
    "recent_submission": "submitted_at within the previous 72 hours",
    "max_matches": 5
  },
  "safety": {
    "advisory_only": true,
    "can_submit_on_success": true,
    "automatic_merge": false,
    "automatic_delete": false,
    "automatic_rejection": false,
    "automatic_suppression": false,
    "certainty_language": false
  },
  "web_review": {
    "possible_matches": {
      "method": "GET",
      "path": "/api/v1/reports/{report}/possible-matches"
    },
    "link": {
      "method": "POST",
      "path": "/api/v1/reports/{report}/duplicate-link",
      "authentication": {
        "roles": [
          "reviewer",
          "admin"
        ]
      },
      "body": {
        "canonical_report_uuid": "required UUID",
        "reason": "optional string, maximum 1000 characters"
      }
    },
    "preservation": {
      "duplicate_record": true,
      "duplicate_audit": true,
      "canonical_evidence_mutated_by_link_or_duplicate_close": false
    }
  }
}
