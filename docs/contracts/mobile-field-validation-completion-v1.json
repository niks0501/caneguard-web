{
  "$id": "https://github.com/niks0501/caneguard-web/blob/main/docs/contracts/mobile-field-validation-completion-v1.json",
  "artifact_format": "caneguard-multipart-contract",
  "contract": "mobile-field-validation-completion-v1",
  "version": 1,
  "status": "stable",
  "owner": "niks0501/caneguard-web/api",
  "wire": {
    "method": "POST",
    "path": "/api/v1/mobile/assignments/{assignment}/completion",
    "content_type": "multipart/form-data",
    "undeclared_fields": "ignored",
    "path_parameters": {
      "assignment": { "type": "uuid", "required": true }
    }
  },
  "authentication": {
    "transport": "Sanctum bearer token",
    "required_ability": "assignment:complete",
    "server_authority": "field reporter role and authenticated assignment ownership"
  },
  "fields": {
    "client_uuid": {
      "wire_type": "text",
      "type": "uuid",
      "required": true,
      "nullable": false,
      "format": "uuid"
    },
    "field_observation": {
      "wire_type": "text",
      "type": "string",
      "required": true,
      "nullable": false,
      "max_length": 2000
    },
    "field_finding": {
      "wire_type": "text",
      "type": "string",
      "required": true,
      "nullable": false,
      "max_length": 2000
    },
    "action_taken": {
      "wire_type": "text",
      "type": "string",
      "required": true,
      "nullable": false,
      "max_length": 2000
    },
    "follow_up_outcome": {
      "wire_type": "text",
      "type": "string",
      "required": false,
      "nullable": true,
      "enum": ["improved", "unchanged", "worsened", "unable_to_determine"]
    },
    "visited_at": {
      "wire_type": "text",
      "type": "date-time",
      "required": true,
      "nullable": false,
      "format": "date-time"
    },
    "gps_outcome": {
      "wire_type": "text",
      "type": "string",
      "required": true,
      "nullable": false,
      "enum": ["resolved", "low_accuracy", "permission_denied", "unavailable", "error"]
    },
    "gps_attempted_at": {
      "wire_type": "text",
      "type": "date-time",
      "required": true,
      "nullable": false,
      "format": "date-time"
    },
    "gps_latitude": {
      "wire_type": "text",
      "type": "number",
      "required": false,
      "nullable": true,
      "minimum": -90,
      "maximum": 90
    },
    "gps_longitude": {
      "wire_type": "text",
      "type": "number",
      "required": false,
      "nullable": true,
      "minimum": -180,
      "maximum": 180
    },
    "gps_accuracy": {
      "wire_type": "text",
      "type": "number",
      "required": false,
      "nullable": true,
      "minimum": 0
    },
    "fresh_photo": {
      "wire_type": "file",
      "type": "image",
      "required": false,
      "nullable": true,
      "formats": [
        {
          "name": "jpeg",
          "extensions": ["jpg", "jpeg"],
          "mime_types": ["image/jpeg"]
        },
        {
          "name": "png",
          "extensions": ["png"],
          "mime_types": ["image/png"]
        },
        {
          "name": "webp",
          "extensions": ["webp"],
          "mime_types": ["image/webp"]
        }
      ],
      "max_bytes": 10485760,
      "metadata": {
        "server_derived_fields": {
          "mime_type": { "type": "string", "source": "uploaded image" },
          "size_bytes": { "type": "integer", "source": "uploaded image" }
        }
      }
    }
  },
  "response": {
    "content_type": "application/json",
    "required_keys": ["data"],
    "data_keys": ["completion", "assignment", "case"]
  },
  "versioning": {
    "same_major_compatible_widening": [
      "adding optional response or request fields",
      "adding GPS outcome values while preserving existing meanings",
      "increasing documented text or numeric bounds"
    ],
    "new_major_required": [
      "removing or renaming a field",
      "changing a field type or nullability",
      "making fresh_photo mandatory",
      "changing assignment ownership or lifecycle semantics"
    ]
  }
}
