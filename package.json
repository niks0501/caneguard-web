{
  "name": "caneguard-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:railway-runtime": "node --test scripts/railway-runtime.node-test.mjs",
    "verify:production-bundle": "node scripts/verify-production-bundle.mjs",
    "test:vite-source-safety": "node --test scripts/vite-tailwind-source-safety.node-test.mjs",
    "test:design-spine": "node --test scripts/validate-design-spine.node-test.mjs && node scripts/validate-design-spine.mjs",
    "security:dependency-check": "node scripts/security-dependency-check.mjs",
    "test:quality-gate-workflow": "node --test scripts/quality-gate-workflow.node-test.mjs",
    "graphify:validate": "node scripts/validate-graphify-artifacts.mjs",
    "test:watch": "vitest",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "api:install": "composer install --working-dir=api",
    "api:dev": "php -d upload_max_filesize=12M -d post_max_size=16M -S 0.0.0.0:8000 -t api/public api/server.php",
    "api:queue": "php api/artisan queue:listen --tries=1 --timeout=0",
    "api:reverb": "php api/artisan reverb:start",
    "api:test": "cd api && php artisan test",
    "api:test:mysql": "cd api && vendor/bin/phpunit --configuration=phpunit.mysql.xml",
    "api:format:check": "cd api && vendor/bin/pint --test",
    "staging": "node scripts/qa-staging.mjs",
    "qa:staging": "node scripts/qa-staging.mjs",
    "qa:staging:test": "node --test scripts/qa-staging.node-test.mjs",
    "qa:legacy:open": "node scripts/qa-open.mjs",
    "qa:legacy:open:test": "node --test scripts/qa-open.node-test.mjs",
    "qa:legacy:close": "node scripts/qa-close.mjs",
    "qa:legacy:close:test": "node --test scripts/qa-close.node-test.mjs",
    "qa:legacy:reconcile": "node scripts/qa-reconcile.mjs",
    "qa:legacy:reconcile:test": "node --test scripts/qa-reconcile.node-test.mjs",
    "api:migrate": "php api/artisan migrate",
    "api:seed": "php api/artisan db:seed",
    "contract:accounts-artifact": "node --test scripts/validate-accounts-access-v1.node-test.mjs && node scripts/validate-accounts-access-v1.mjs",
    "contract:artifact": "node scripts/validate-mobile-report-upload-v1.mjs",
    "contract:v2:artifact": "node scripts/validate-mobile-report-upload-v2.mjs",
    "contract:assignment-artifact": "node scripts/validate-mobile-field-validation-assignment-v1.mjs",
    "contract:completion-artifact": "node scripts/validate-mobile-field-validation-completion-v1.mjs",
    "contract:notification-artifact": "node scripts/validate-mobile-notifications-v1.mjs",
    "contract:status-v3-artifact": "node scripts/validate-mobile-report-status-v3.mjs",
    "contract:lifecycle-artifact": "node scripts/validate-report-lifecycle-v1.mjs",
    "contract:config": "node scripts/resolve-mobile-report-upload-gate-config.mjs",
    "contract:consumer": "node scripts/run-laravel-mobile-report-upload-consumer-contract.mjs",
    "contract:assignment-consumer": "node scripts/run-laravel-mobile-field-validation-assignment-consumer-contract.mjs",
    "contract:completion-consumer": "node scripts/run-laravel-mobile-field-validation-completion-consumer-contract.mjs",
    "contract:notification-consumer": "node scripts/run-laravel-mobile-notification-consumer-contract.mjs",
    "contract:lifecycle-consumer": "node scripts/run-laravel-report-lifecycle-consumer-contract.mjs",
    "contract:producer": "node scripts/run-mobile-report-upload-producer-contract.mjs",
    "contract:assignment-producer": "node scripts/run-mobile-field-validation-assignment-producer-contract.mjs",
    "contract:completion-producer": "node scripts/run-mobile-field-validation-completion-producer-contract.mjs",
    "contract:notification-producer": "node scripts/run-mobile-notification-producer-contract.mjs",
    "contract:lifecycle-producer": "node scripts/run-report-lifecycle-producer-contract.mjs",
    "contract:gate": "npm run contract:artifact && npm run contract:v2:artifact && npm run contract:status-v3-artifact && npm run contract:assignment-artifact && npm run contract:completion-artifact && npm run contract:notification-artifact && npm run contract:lifecycle-artifact && npm run contract:config && npm run contract:test && npm run contract:consumer && npm run contract:assignment-consumer && npm run contract:completion-consumer && npm run contract:notification-consumer && npm run contract:lifecycle-consumer && npm run contract:producer && npm run contract:assignment-producer && npm run contract:completion-producer && npm run contract:notification-producer && npm run contract:lifecycle-producer",
    "contract:test": "node --test scripts/validate-mobile-report-upload-v2.node-test.mjs scripts/validate-mobile-report-status-v3.node-test.mjs scripts/validate-mobile-report-upload-v1.node-test.mjs scripts/validate-mobile-field-validation-assignment-v1.node-test.mjs scripts/validate-mobile-field-validation-completion-v1.node-test.mjs scripts/validate-mobile-notifications-v1.node-test.mjs scripts/validate-report-lifecycle-v1.node-test.mjs scripts/phase1-lifecycle-acceptance.node-test.mjs scripts/resolve-mobile-report-upload-gate-config.node-test.mjs scripts/mobile-report-upload-contract-workflow.node-test.mjs",
    "phase1:acceptance": "node scripts/run-phase1-lifecycle-acceptance.mjs",
    "phase1:acceptance:test": "node --test scripts/phase1-lifecycle-acceptance.node-test.mjs",
    "check:web": "npm run lint && npm run typecheck && npm run test && npm run test:vite-source-safety && npm run test:design-spine && npm run contract:accounts-artifact && npm run security:dependency-check && npm run test:quality-gate-workflow && npm run test:railway-runtime && npm run build && npm run verify:production-bundle",
    "check:api": "npm run api:test && npm run api:format:check",
    "verify:fast": "npm run check:web",
    "verify:backend": "npm run check:api && npm run api:test:mysql",
    "verify:contract": "npm run contract:gate",
    "check:all": "npm run check:web && npm run check:api && npm run graphify:validate"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "laravel-echo": "^2.4.0",
    "lucide-react": "^1.25.0",
    "maplibre-gl": "^6.9.0",
    "pusher-js": "^8.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-map-gl": "^8.1.2",
    "react-router": "^8.3.0",
    "recharts": "3.10.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  }
}
