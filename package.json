{
  "name": "caneguard-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "api:install": "composer install --working-dir=api",
    "api:dev": "php api/artisan serve --host=127.0.0.1 --port=8000",
    "api:test": "cd api && php artisan test",
    "api:format:check": "cd api && vendor/bin/pint --test",
    "api:migrate": "php api/artisan migrate",
    "api:seed": "php api/artisan db:seed",
    "check:web": "npm run lint && npm run typecheck && npm run build",
    "check:api": "npm run api:test && npm run api:format:check",
    "check:all": "npm run check:web && npm run check:api"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
