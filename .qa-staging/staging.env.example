# Copy this file to .qa-staging/staging.env.
# The copied file is ignored and is the only runtime source for QA staging.
# Keep this file local, chmod 600, and never commit its passwords or APP_KEY.

QA_BRANCH=qa/candidate
QA_WORKTREE_PATH=.qa-staging/worktree
QA_API_HOST=127.0.0.1
QA_API_PORT=18000
QA_API_URL=http://127.0.0.1:18000
QA_WEB_HOST=127.0.0.1
QA_WEB_PORT=15173
QA_WEB_URL=http://127.0.0.1:15173

APP_NAME=CaneGuard
APP_ENV=qa-staging
APP_KEY=
APP_DEBUG=false
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
APP_URL=http://127.0.0.1:18000
FRONTEND_URL=http://127.0.0.1:15173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:15173
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:15173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=caneguard_staging
DB_USERNAME=caneguard_app
DB_PASSWORD=
DB_URL=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_TIMEZONE=+00:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=127.0.0.1
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log

CANEGUARD_FIELD_PASSWORD=
CANEGUARD_REVIEWER_PASSWORD=
CANEGUARD_ADMIN_PASSWORD=

VITE_API_BASE_URL=http://127.0.0.1:18000
VITE_DATA_SOURCE=api
VITE_REPORT_REFRESH_MS=600000
VITE_MAPTILER_KEY=
